# ==========================================
# Настройки базы данных
# ==========================================
# Рекомендуемый вариант (не требует установки сервера БД):
DB_ENGINE=sqlite
DB_PATH=data/dataset.db

# Если вы хотите использовать MySQL (раскомментируйте и заполните):
# DB_ENGINE=mysql
# DB_USER=root
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=pig_dataset

# [STAGE2:api-key] API v2 Bearer token (пусто = auth off)
API_KEY=
