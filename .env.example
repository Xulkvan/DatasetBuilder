# ==========================================
# Настройки базы данных
# ==========================================
# Рекомендуемый вариант (не требует установки сервера БД):
DB_ENGINE=sqlite
DB_PATH=data/dataset.db

# Если вы хотите использовать MySQL (раскомментируйте и заполните):
# DB_ENGINE=mysql
# DB_USER=root
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=pig_dataset

# ── PostgreSQL (Team Edition, docker compose --profile team) ──
# DB_ENGINE=postgres
# DB_USER=postgres
# DB_PASSWORD=change_me
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=pig_dataset

# ── API v2 (Bearer) ──────────────────────────────────────────
# ВАЖНО: если API_KEY пуст, /api/v2/* возвращает 503 (fail-closed).
# Задайте секретный токен, чтобы включить B2B API:
API_KEY=
# API_KEY — plain string (global admin) или JSON map для scoped доступа:
#   API_KEY='{"tokenA": {"projects": [1,2]}, "tokenB": {"projects": "*"}}'
# Если оставить plain string — backward-compat, global-доступ ко всем проектам.

# ── Team Edition: режим работы ────────────────────────────────
# local  = без логина (как раньше, для соло)
# team   = логин, роли, назначения, блокировки
# auto   = local для sqlite, team для mysql/postgres (по умолчанию)
AUTH_MODE=auto

# ── Сессии (только для team) ──────────────────────────────────
SESSION_TTL_DAYS=7
# auto — Secure-cookie только по HTTPS (для http://192.168.x.x оставить auto)
SESSION_COOKIE_SECURE=auto

# CSRF double-submit
# 1 = cookie pdb_csrf + заголовок X-CSRF-Token (default, для прода)
# 0 = только X-Requested-With (для тестов / отладки)
CSRF_STRICT=1

# ── Reverse-proxy ────────────────────────────────────────────
# TRUST_PROXY_HEADERS=1 — доверять X-Forwarded-For / X-Real-IP.
# Включать ТОЛЬКО если приложение за доверенным nginx/traefik,
# иначе клиент подделает IP и обойдёт rate-limit логина.
TRUST_PROXY_HEADERS=0

# ── Блокировка кадров (только для team) ───────────────────────
LOCK_TTL_SECONDS=300

# ── Webhook SSRF ─────────────────────────────────────────────
# 0 = блокировать вебхуки на localhost / приватные IP (по умолчанию)
# 1 = разрешить (ТОЛЬКО для локальной разработки!)
WEBHOOK_ALLOW_PRIVATE=0

# ── Импорт из локальной папки ────────────────────────────────
# Дополнительный корень, разрешённый для /api/import/local_folder.
# Пусто = только DATA_ROOT/imports и DATA_ROOT/uploads.
# Должен быть подкаталогом DATA_ROOT.
IMPORT_ROOT=

# ── Лимиты (МБ) ──────────────────────────────────────────────
#Влияют на загрузку файлов, импорт архивов
#и извлечение кадров. Дефолты соответствуют config.py;
# увеличивайте осторожно — больше значение, больше риск OOM/DoS.

# Одна картинка (upload + импорт одной картинки).
# Также используется как лимит на одну картинку при импорте из
# Labelbox / Scale AI (фоновое скачивание для COCO-конвертации).
MAX_UPLOAD_MB=50

# Zip-архив импорта и экспорт из внешних сервисов
# (Roboflow, Supervisely, Labelbox, Scale AI, V7 Darwin).
# Это же значение — дефолтный лимит скачивания по прямой ссылке
# (импорт URL): Content-Length проверяется до скачивания,
# итоговый размер — потоково на каждом 1 МБ.
MAX_IMPORT_MB=2048

# Видео и максимальное число кадров из него.
MAX_VIDEO_MB=2048
MAX_VIDEO_FRAMES=3000

# Ограничения распаковки zip:
#   MAX_EXTRACTED_MB    — суммарный распакованный размер
#   MAX_EXTRACTED_FILES — количество файлов в архиве
# Защищают от «архивных бомб» (миллион мелких файлов или огромный
# PNG с одним цветом, раздувающийся при декомпрессии).
MAX_EXTRACTED_MB=10240
MAX_EXTRACTED_FILES=10000

# Требовать поле `revision` в POST /api/images/{id}/annotations (team mode).
# 0 = backward compat (default), 1 = strict (рекомендуется в team mode).
REQUIRE_ANNOTATION_REVISION=0

# off|basic — Basic-auth для /api/metrics
# Startup scan: off | sample | full (default: sample)
STARTUP_SCAN=sample

# off | basic — Basic-auth для /api/metrics.
# ⚠️ В production используйте METRICS_AUTH=basic и задайте METRICS_BASIC_USER/PASSWORD.
METRICS_AUTH=basic
# username для METRICS_AUTH=basic
METRICS_BASIC_USER=
# password для METRICS_AUTH=basic
METRICS_BASIC_PASSWORD=
