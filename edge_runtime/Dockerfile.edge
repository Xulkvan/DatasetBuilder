# [PATCH:STAGE3_2:edge-dockerfile]
# Lightweight Edge runtime for NVIDIA Jetson (L4T r35.2.1 / JetPack 5.1.2)
# Build from inside edge_package/:
#     docker build -f Dockerfile -t db-edge:latest .
#     docker run --runtime nvidia --network host \
#         -e EDGE_RTSP_URL="rtsp://camera.local/stream1" \
#         db-edge:latest

FROM nvcr.io/nvidia/l4t-base:r35.2.1

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    EDGE_PORT=8080 \
    EDGE_IMGSZ=640 \
    EDGE_CONF=0.25 \
    EDGE_IOU=0.45 \
    EDGE_MODEL_PATH=/app/model.onnx

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        libgl1 libglib2.0-0 libgomp1 \
        ffmpeg curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ONNX Runtime GPU wheel for Jetson (best-effort; falls back to CPU wheel)
RUN pip3 install --no-cache-dir \
        https://developer.download.nvidia.com/compute/redist/jp/v512/onnxruntime_gpu/onnxruntime_gpu-1.14.0-cp38-cp38-linux_aarch64.whl \
    || pip3 install --no-cache-dir onnxruntime

RUN pip3 install --no-cache-dir \
        "fastapi==0.111.0" \
        "uvicorn[standard]==0.30.1" \
        "opencv-python-headless==4.9.0.80" \
        "numpy==1.24.4" \
        "pydantic>=2.0"

WORKDIR /app

COPY edge_server.py /app/edge_server.py
COPY model.onnx     /app/model.onnx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/health || exit 1

CMD ["python3", "/app/edge_server.py"]
